   "source": [
    "best_model = search.best_estimator_\n",
    "y_pred = best_model.predict(X_test)\n",
    "y_proba_malin = best_model.predict_proba(X_test)[:, list(best_model.classes_).index(1)]\n",
    "\n",
    "metrics_final = {\n",
    "    \"Accuracy\": accuracy_score(y_test, y_pred),\n",
