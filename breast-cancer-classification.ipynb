   "source": [
    "## 5. Optimisation du modèle\n",
    "\n",
    "On optimise la régression logistique à l'aide d'une grille d'hyperparamètres et d'une validation croisée stratifiée. Le critère de sélection est le rappel de la classe maligne, tout en consultant l'AUC. Ce choix illustre une priorité de réduction des faux négatifs ; il ne constitue pas une recommandation clinique universelle."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "f526c7e8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Meilleurs paramètres : {'model__C': 0.1, 'model__solver': 'liblinear'}\n",
      "Meilleur rappel CV : 0.959\n"
     ]
    }
   ],
   "source": [
    "pipeline_lr = Pipeline([\n",
    "    (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "    (\"scaler\", StandardScaler()),\n",
    "    (\"model\", LogisticRegression(max_iter=8000, class_weight=\"balanced\", random_state=SEED))\n",
    "])\n",
    "param_grid = {\n",
    "    \"model__C\": [0.001, 0.01, 0.1, 1, 10, 100],\n",
    "    \"model__solver\": [\"liblinear\", \"lbfgs\"],\n",
    "}\n",
    "search = GridSearchCV(\n",
    "    pipeline_lr, param_grid, scoring=\"recall\", cv=cv, n_jobs=-1,\n",
    "    refit=True, return_train_score=True\n",
    ")\n",
    "search.fit(X_train, y_train)\n",
    "print(\"Meilleurs paramètres :\", search.best_params_)\n",
    "print(f\"Meilleur rappel CV : {search.best_score_:.3f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "6940db35",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "grid_results = pd.DataFrame(search.cv_results_)\n",
    "grid_results[\"C\"] = grid_results[\"param_model__C\"].astype(float)\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "for solver, group in grid_results.groupby(\"param_model__solver\"):\n",
    "    means = group.groupby(\"C\")[\"mean_test_score\"].mean().sort_index()\n",
    "    ax.plot(means.index, means.values, marker=\"o\", label=solver)\n",
    "ax.set_xscale(\"log\")\n",
    "ax.set_ylim(0, 1.02)\n",
    "ax.set_xlabel(\"C (échelle logarithmique)\")\n",
    "ax.set_ylabel(\"Rappel malin moyen\")\n",
    "ax.set_title(\"Recherche d'hyperparamètres — validation croisée\")\n",
    "ax.legend(title=\"Solver\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
