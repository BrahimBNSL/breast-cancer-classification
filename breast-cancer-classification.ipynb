    "    \"Précision malin\": precision_score(y_test, y_pred, zero_division=0),\n",
    "    \"Rappel malin\": recall_score(y_test, y_pred, zero_division=0),\n",
    "    \"F1 malin\": f1_score(y_test, y_pred, zero_division=0),\n",
    "    \"ROC-AUC (malin positif)\": roc_auc_score(y_test, y_proba_malin),\n",
    "    \"Average Precision\": average_precision_score(y_test, y_proba_malin),\n",
    "}\n",
    "display(pd.DataFrame.from_dict(metrics_final, orient=\"index\", columns=[\"Score\"]))\n",
    "print(\"\\nRapport de classification (1 = malin) :\")\n",
    "print(classification_report(y_test, y_pred, target_names=[\"Bénigne\", \"Maligne\"], zero_division=0))"
