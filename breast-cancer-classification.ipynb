    "cluster_scores = pd.DataFrame([{\n",
    "    \"Silhouette\": silhouette_score(X_train_scaled, clusters),\n",
    "    \"ARI vs diagnostic\": adjusted_rand_score(y_train, clusters),\n",
    "    \"NMI vs diagnostic\": normalized_mutual_info_score(y_train, clusters)\n",
    "}], index=[\"K-means\"])\n",
    "display(cluster_scores.round(3))"
   ]
